[Unit]
Description=voipstack SIP sequencer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/sip-sequencer --config /etc/voipstack-sip-sequencer/config.yaml

# Restart on crash, but a persistently bad config halts as a *failed* unit (not an
# endless loop): after StartLimitBurst failures within StartLimitIntervalSec systemd
# gives up and leaves the unit in `failed` state, visible in systemctl status/journal.
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=60
StartLimitBurst=3

# Must be >= the engine's 5s graceful-shutdown window so in-flight calls BYE cleanly
# on SIGTERM before systemd escalates to SIGKILL.
TimeoutStopSec=10

# Run non-root. SIP binds the privileged port :5060, so grant only CAP_NET_BIND_SERVICE.
# If your config listens on a high (>1024) SIP port, you can drop AmbientCapabilities.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Conservative hardening. Config is the only runtime input and is read-only to the service.
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/voipstack-sip-sequencer

[Install]
WantedBy=multi-user.target
